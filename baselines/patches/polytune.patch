+# Track names written into the predicted MIDI, keyed by error class
+# (note.instrument in the decoded NoteSequence): 1 = Extra, 2 = Missing, 3 = Correct.
+ERROR_CLASS_TRACK_NAMES = {1: "extra", 2: "missing", 3: "correct"}
+
+
+def resolve_device(preferred=None):
+    """Pick the inference device: POLYTUNE_DEVICE env var > cuda > mps > cpu.
+
+    Identical to the original hard-coded torch.device("cuda") whenever CUDA is available.
+    """
+    name = preferred or os.environ.get("POLYTUNE_DEVICE")
+    if name:
+        return torch.device(name)
+    if torch.cuda.is_available():
+        return torch.device("cuda")
+    mps = getattr(torch.backends, "mps", None)
+    if mps is not None and mps.is_available():
+        return torch.device("mps")
+    return torch.device("cpu")
+
+
+def name_error_class_tracks(ns):
+    """Attach instrument_infos so note_sequence_to_midi_file names each output track.
+
+    pretty_midi then exposes the class as Instrument.name ('extra'/'missing'/'correct')
+    instead of relying on track position, which shifts when a class has no notes.
+    """
+    del ns.instrument_infos[:]
+    for error_class, name in ERROR_CLASS_TRACK_NAMES.items():
+        info = ns.instrument_infos.add()
+        info.instrument = error_class
+        info.name = name
+    return ns
+
 
